{
  "name": "zig-lang-support",
  "displayName": "Zig-Lang-Support",
  "description": "Powerful Zig support: official-compatible highlighting, ZLS intelligence, diagnostics, formatting, tasks, and dependency workflows.",
  "version": "0.4.1",
  "publisher": "zig-lang-support",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hexadecimall/Zig-Lang-Support.git"
  },
  "bugs": {
    "url": "https://github.com/Hexadecimall/Zig-Lang-Support/issues"
  },
  "homepage": "https://github.com/Hexadecimall/Zig-Lang-Support#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters",
    "Snippets"
  ],
  "keywords": [
    "zig",
    "zls",
    "formatter",
    "dependencies",
    "language server"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:zig",
    "workspaceContains:build.zig",
    "workspaceContains:build.zig.zon"
  ],
  "contributes": {
    "languages": [
      {
        "id": "zig",
        "aliases": [
          "Zig"
        ],
        "extensions": [
          ".zig",
          ".zon"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zig",
        "scopeName": "source.zig",
        "path": "./syntaxes/zig.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[zig]": {
        "editor.defaultFormatter": "zig-lang-support.zig-lang-support",
        "editor.formatOnSave": true,
        "editor.quickSuggestions": { "other": true, "comments": false, "strings": false },
        "editor.suggestOnTriggerCharacters": true,
        "editor.snippetSuggestions": "top",
        "files.eol": "\n"
      },
      "files.exclude": {
        "**/.zig-cache": true,
        "**/zig-cache": true
      }
    },
    "configuration": {
      "title": "Zig-Lang-Support",
      "properties": {
        "zigLangSupport.zig.path": {
          "type": "string",
          "default": "zig",
          "scope": "resource",
          "description": "Path to the Zig executable, or zig to resolve it from PATH."
        },
        "zigLangSupport.zls.path": {
          "type": "string",
          "default": "zls",
          "scope": "resource",
          "description": "Path to ZLS. Leave as zls to resolve it from PATH."
        },
        "zigLangSupport.zls.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Use ZLS for semantic completion, navigation, hover, symbols, and diagnostics when available."
        },
        "zigLangSupport.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Run Zig compiler diagnostics for saved files when ZLS is unavailable."
        },
        "zigLangSupport.diagnostics.onSave": {
          "type": "boolean",
          "default": true,
          "description": "Refresh fallback compiler diagnostics after saving a Zig source file."
        },
        "zigLangSupport.diagnostics.debounceMs": {
          "type": "number",
          "default": 500,
          "minimum": 100,
          "description": "Delay before fallback diagnostics run after an edit."
        },
        "zigLangSupport.format.args": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Additional arguments sent to zig fmt."
        },
        "zigLangSupport.tasks.extraArgs": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Arguments appended to Zig build tasks."
        }
      }
    },
    "commands": [
      {
        "command": "zigLangSupport.formatDocument",
        "title": "Format Document",
        "category": "Zig-Lang-Support"
      },
      {
        "command": "zigLangSupport.build",
        "title": "Build Project",
        "category": "Zig-Lang-Support"
      },
      {
        "command": "zigLangSupport.run",
        "title": "Run Project",
        "category": "Zig-Lang-Support"
      },
      {
        "command": "zigLangSupport.test",
        "title": "Test Current File",
        "category": "Zig-Lang-Support"
      },
      {
        "command": "zigLangSupport.addDependency",
        "title": "Add Dependency",
        "category": "Zig-Lang-Support"
      },
      {
        "command": "zigLangSupport.fetchDependencies",
        "title": "Fetch Dependencies",
        "category": "Zig-Lang-Support"
      },
      {
        "command": "zigLangSupport.restartLanguageServer",
        "title": "Restart Language Server",
        "category": "Zig-Lang-Support"
      },
      {
        "command": "zigLangSupport.showProject",
        "title": "Show Project Dashboard",
        "category": "Zig-Lang-Support"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "zigLangSupport.addDependency",
          "when": "workspaceContains:build.zig.zon"
        }
      ]
    },
    "snippets": [
      {
        "language": "zig",
        "path": "./snippets/zig.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "zigLangSupport",
          "title": "Zig-Lang-Support",
          "icon": "media/zig.svg"
        }
      ]
    },
    "views": {
      "zigLangSupport": [
        {
          "id": "zigLangSupport.project",
          "name": "Project Manager",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "bundle": "esbuild src/extension.ts --bundle --platform=node --target=node20 --format=cjs --external:vscode --outfile=out/extension.js",
    "compile": "npm run check && npm run bundle",
    "watch": "tsc -watch -p .",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package",
    "check": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.4",
    "vscode-languageclient": "^9.0.1"
  }
}
